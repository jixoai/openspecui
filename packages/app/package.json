{
  "name": "@openspecui/app",
  "version": "11.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:dist": "vite build --watch",
    "build": "pnpm -w build:native-icons && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.p2-tests.json --noEmit && tsc -p tsconfig.p3b-tests.json --noEmit && tsc -p tsconfig.p3c-tests.json --noEmit && tsc -p tsconfig.p4-tests.json --noEmit",
    "typecheck:p3b-tests": "tsc -p tsconfig.p3b-tests.json --noEmit",
    "typecheck:p3c-tests": "tsc -p tsconfig.p3c-tests.json --noEmit",
    "typecheck:p2-tests": "tsc -p tsconfig.p2-tests.json --noEmit",
    "typecheck:p4-tests": "tsc -p tsconfig.p4-tests.json --noEmit",
    "test": "vitest run",
    "test:browser:ci": "vitest run --config vitest.browser.config.ts",
    "cf:dev": "pnpm build && wrangler pages dev dist",
    "cf:deploy": "pnpm build && wrangler pages deploy dist --project-name openspecui-app",
    "cf:project:create": "wrangler pages project create openspecui-app --production-branch main"
  },
  "devDependencies": {
    "@openspecui/core": "workspace:*",
    "@openspecui/server": "workspace:*",
    "@opentray/vite-plugin": "0.18.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-router": "^1.99.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@trpc/client": "^11.7.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.0",
    "@vitest/browser-playwright": "^4.1.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.472.0",
    "playwright": "^1.58.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.72.0"
  }
}
