{
  "name": "@openspecui/server",
  "version": "9.0.1",
  "type": "module",
  "main": "dist/index.mjs",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.check.json --noEmit && tsc -p tsconfig.search-tests.json --noEmit && tsc -p tsconfig.git-tests.json --noEmit && tsc -p tsconfig.transport-tests.json --noEmit && tsc -p tsconfig.pty-tests.json --noEmit && tsc -p tsconfig.workflow-contract-tests.json --noEmit && tsc -p tsconfig.nested-spec-tests.json --noEmit && tsc -p tsconfig.default-store-tests.json --noEmit && tsc -p tsconfig.agent-delivery-tests.json --noEmit && tsc -p tsconfig.project-initialization-tests.json --noEmit",
    "typecheck:agent-delivery-tests": "tsc -p tsconfig.agent-delivery-tests.json --noEmit",
    "typecheck:git-tests": "tsc -p tsconfig.git-tests.json --noEmit",
    "typecheck:pty-tests": "tsc -p tsconfig.pty-tests.json --noEmit",
    "typecheck:search-tests": "tsc -p tsconfig.search-tests.json --noEmit",
    "typecheck:transport-tests": "tsc -p tsconfig.transport-tests.json --noEmit",
    "typecheck:workflow-contract-tests": "tsc -p tsconfig.workflow-contract-tests.json --noEmit",
    "typecheck:nested-spec-tests": "tsc -p tsconfig.nested-spec-tests.json --noEmit",
    "typecheck:project-initialization-tests": "tsc -p tsconfig.project-initialization-tests.json --noEmit",
    "typecheck:default-store-tests": "tsc -p tsconfig.default-store-tests.json --noEmit",
    "dev": "tsx watch --conditions=development --include '../core/dist/**' --include '../search/dist/**' src/standalone.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@huggingface/hub": "^2.12.0",
    "@lydell/node-pty": "^1.1.0",
    "@openspecui/core": "workspace:*",
    "@openspecui/local-ct2-translator": "workspace:*",
    "@openspecui/local-llama-translator": "workspace:*",
    "@openspecui/local-translator": "workspace:*",
    "@openspecui/openai-completion-translator": "workspace:*",
    "@openspecui/search": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@trpc/server": "^11.0.0",
    "better-sqlite3": "^12.5.0",
    "hono": "^4.7.3",
    "ts-pattern": "5.9.0",
    "undici": "^7.18.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "// runtime-note": "Translation runtimes are installed on demand from the settings panel instead of being pulled in during startup.",
  "// bundle-note": "The translator engine packages keep heavyweight runtime imports external in tsdown output, so this host package resolves install ranges on demand when the user chooses a local engine.",
  "peerDependencies": {
    "ctranslate2": "^1.0.0",
    "node-llama-cpp": "~3.18.1"
  },
  "peerDependenciesMeta": {
    "ctranslate2": {
      "optional": true
    },
    "node-llama-cpp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@trpc/client": "^11.7.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@types/yargs": "^17.0.35",
    "openspec-cli-16": "npm:@fission-ai/openspec@1.6.0",
    "tsx": "^4.19.2",
    "tsdown": "^0.16.6",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0",
    "yaml": "^2.8.0",
    "yargs": "^18.0.0"
  }
}
